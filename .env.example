# Google Gemini API Key
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model to use for translation
# Options: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro, etc.
GEMINI_MODEL=gemini-2.5-flash

# Default subtitle batch size per Gemini translation request
GEMINI_BATCH_SIZE=40
